{
  "name": "neuro-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 9002",
    "dev:worker": "tsx watch --env-file=.env src/worker/index.ts",
    "build": "next build && npm run build:scripts",
    "build:scripts": "esbuild src/worker/index.ts --bundle --platform=node --target=node20 --packages=external --alias:@=./src --outfile=dist/worker.js && esbuild src/server/db/migrate.ts --bundle --platform=node --target=node20 --packages=external --alias:@=./src --outfile=dist/migrate.js && esbuild src/server/db/seed.ts --bundle --platform=node --target=node20 --packages=external --alias:@=./src --outfile=dist/seed.js",
    "start": "next start -p 9002",
    "start:worker": "node dist/worker.js",
    "lint": "next lint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/server/db/migrate.ts",
    "db:seed": "tsx --env-file=.env src/server/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "genkit:dev": "genkit start -- tsx src/server/ai/dev.ts",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:migrate:prod": "node dist/migrate.js",
    "db:seed:prod": "node dist/seed.js"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@genkit-ai/googleai": "^1.14.1",
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@tanstack/react-query": "^5.103.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "drizzle-orm": "^0.44.7",
    "embla-carousel-react": "^8.6.0",
    "genkit": "^1.14.1",
    "lucide-react": "^0.475.0",
    "next": "15.3.8",
    "pg": "^8.23.0",
    "pino": "^9.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.56.1",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^3.2.7",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.3.8",
    "genkit-cli": "^1.14.1",
    "pino-pretty": "^13.1.3",
    "postcss": "^8",
    "prettier": "^3.9.8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.11"
  },
  "prettier": {
    "singleQuote": true,
    "semi": true,
    "trailingComma": "all",
    "printWidth": 120
  }
}
